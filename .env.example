# Copy to .env and fill in. .env is in .gitignore: never commit real values.
# On Vercel, add the same names under Project Settings > Environment Variables.

# Gemini (Google AI Studio key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Auth0 application (Regular Web Application)
AUTH0_DOMAIN=hackcamp2026.ca.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32+ random characters, used to encrypt the login cookie. Generate: openssl rand -hex 32
AUTH0_SECRET=

# Tiger Cloud service connection string (postgres://tsdbadmin:...tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require).
# Load it with: TIGER_URL=... npm run db:tiger. A Supabase pooler string also works (skip db/tiger.sql).
DATABASE_URL=
TIGER_URL=

# Optional: force the public URL used for Auth0 redirects (otherwise taken from the request)
# APP_BASE_URL=https://your-app.vercel.app
